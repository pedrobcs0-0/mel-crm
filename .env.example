# Copie para .env (local) ou cadastre na Vercel. NUNCA commite valores reais.
DATABASE_URL=postgres://postgres@localhost:5432/mel
# Senha única de acesso ao painel
APP_PASSWORD=
# Texto aleatório longo (mínimo 32 caracteres) usado para assinar o login
SESSION_SECRET=
# Provedor de IA: openai (padrão). "mock" só para testes automatizados.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Teto mensal absoluto em US$ (a tela de Consumo não consegue ultrapassar)
AI_HARD_MONTHLY_CAP_USD=10
